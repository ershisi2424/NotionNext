# Copy to /etc/notionnext-acme/credentials.env, owned by root, mode 600.
# Use a dedicated DNS identity restricted to this domain. Never commit real keys.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
ACME_EMAIL=ershisigu@qq.com
# Set to yes only after the owner accepts the current Let's Encrypt agreement.
ACME_ACCEPT_TERMS=no
