{
  "cleanUrls": false,
  "trailingSlash": false,
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_MESSAGE\" in *\"[skip-version]\"*) exit 0;; *) exit 1;; esac",
  "headers": [],
  "functions": {
    "api/showcase.py": {
      "includeFiles": "interactive-showcase/**",
      "excludeFiles": "{interactive-showcase/public/**,interactive-showcase/mac-*,interactive-showcase/__pycache__/**}"
    }
  },
  "rewrites": [
    {
      "source": "/_next/image",
      "destination": "/api/showcase?__showcase_path=/_next/image"
    },
    {
      "source": "/",
      "destination": "/api/showcase?__showcase_path=/"
    },
    {
      "source": "/explore",
      "destination": "/api/showcase?__showcase_path=/explore"
    },
    {
      "source": "/works/:path*",
      "destination": "/api/showcase?__showcase_path=/works/:path*"
    },
    {
      "source": "/tank",
      "destination": "/api/showcase?__showcase_path=/tank"
    },
    {
      "source": "/space-invader",
      "destination": "/api/showcase?__showcase_path=/space-invader"
    },
    {
      "source": "/tetris",
      "destination": "/api/showcase?__showcase_path=/tetris"
    },
    {
      "source": "/pac-man",
      "destination": "/api/showcase?__showcase_path=/pac-man"
    },
    {
      "source": "/snake",
      "destination": "/api/showcase?__showcase_path=/snake"
    },
    {
      "source": "/_next/:path*",
      "destination": "/blog/__showcase-assets/_next/:path*"
    },
    {
      "source": "/__zh/:path*",
      "destination": "/blog/__showcase-assets/__zh/:path*"
    },
    {
      "source": "/models/:path*",
      "destination": "/blog/__showcase-assets/models/:path*"
    },
    {
      "source": "/textures/:path*",
      "destination": "/blog/__showcase-assets/textures/:path*"
    },
    {
      "source": "/sounds/:path*",
      "destination": "/blog/__showcase-assets/sounds/:path*"
    },
    {
      "source": "/stills/:path*",
      "destination": "/blog/__showcase-assets/stills/:path*"
    },
    {
      "source": "/projects/:path*",
      "destination": "/blog/__showcase-assets/projects/:path*"
    },
    {
      "source": "/logos/:path*",
      "destination": "/blog/__showcase-assets/logos/:path*"
    },
    {
      "source": "/api/notion-comments",
      "destination": "/blog/api/notion-comments"
    },
    {
      "source": "/api/subscribe",
      "destination": "/blog/api/subscribe"
    },
    {
      "source": "/draco/:path*",
      "destination": "/blog/__showcase-assets/draco/:path*"
    },
    {
      "source": "/icons/:path*",
      "destination": "/blog/__showcase-assets/icons/:path*"
    },
    {
      "source": "/tech-icons/:path*",
      "destination": "/blog/__showcase-assets/tech-icons/:path*"
    },
    {
      "source": "/about/:path*",
      "destination": "/blog/__showcase-assets/about/:path*"
    },
    {
      "source": "/testimonials/:path*",
      "destination": "/blog/__showcase-assets/testimonials/:path*"
    },
    {
      "source": "/gifs/:path*",
      "destination": "/blog/__showcase-assets/gifs/:path*"
    },
    {
      "source": "/tank/:path*",
      "destination": "/api/showcase?__showcase_path=/tank/:path*"
    },
    {
      "source": "/space-invader/:path*",
      "destination": "/api/showcase?__showcase_path=/space-invader/:path*"
    },
    {
      "source": "/pacman/:path*",
      "destination": "/api/showcase?__showcase_path=/pacman/:path*"
    },
    {
      "source": "/tetris/:path*",
      "destination": "/api/showcase?__showcase_path=/tetris/:path*"
    },
    {
      "source": "/snake/:path*",
      "destination": "/api/showcase?__showcase_path=/snake/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/showcase?__showcase_path=/favicon.ico"
    },
    {
      "source": "/apple-icon.png",
      "destination": "/api/showcase?__showcase_path=/apple-icon.png"
    },
    {
      "source": "/icon.svg",
      "destination": "/api/showcase?__showcase_path=/icon.svg"
    },
    {
      "source": "/icon-192.png",
      "destination": "/api/showcase?__showcase_path=/icon-192.png"
    },
    {
      "source": "/icon-512.png",
      "destination": "/api/showcase?__showcase_path=/icon-512.png"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/api/showcase?__showcase_path=/manifest.webmanifest"
    }
  ],
  "buildCommand": "python interactive-showcase/build_vercel.py --output public/__showcase-assets && yarn build"
}
