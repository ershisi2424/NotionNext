{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python build_vercel.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "snapshot/**",
      "excludeFiles": "{public/**,frames/**,sounds/**,mac-*,*.log,__pycache__/**}"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
